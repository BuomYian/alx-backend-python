pipeline {
    agent any

    environment {
        VENV_DIR = "venv"
    }

    stages {
        stage('Checkout') {
            steps {
                // Pull source code from GitHub
                checkout scm
            }
        }

        stage('Setup Python Environment') {
            steps {
                // Create virtual environment and install dependencies
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip3 install --upgrade pip
                    pip3 install -r requirements.txt
                    pip3 install pytest pytest-django pytest-cov
                '''
            }
        }

        stage('Run Tests') {
            steps {
                // Run pytest with coverage and generate reports
                sh '''
                    . venv/bin/activate
                    pytest --junitxml=reports/test-results.xml --cov=. --cov-report=xml:reports/coverage.xml --cov-report=html:reports/htmlcov -v
                '''
            }
        }
    }

    post {
        always {
            // Publish test results
            junit allowEmptyResults: true, testResults: 'reports/test-results.xml'
            
            // Archive coverage reports
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports/htmlcov',
                reportFiles: 'index.html',
                reportName: 'Coverage Report'
            ])
            
            // Clean up workspace
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
    }
}
